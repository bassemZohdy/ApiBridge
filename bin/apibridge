#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="$SCRIPT_DIR/../apibridge-generator/target/apibridge-generator-0.1.0-SNAPSHOT.jar"

if [ ! -f "$JAR" ]; then
  echo "ERROR: JAR not found at $JAR — run 'mvn package' first" >&2
  exit 1
fi

exec java -jar "$JAR" "$@"
